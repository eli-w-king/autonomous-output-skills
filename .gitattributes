# Text files are stored and checked out with LF on every OS, so the shell and Node scripts run the same
# in Git Bash on Windows as on macOS (core.autocrlf=true in Git for Windows would otherwise add CR).
* text=auto eol=lf

# Windows batch files need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Never convert binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.db binary
*.sqlite binary
*.pyc binary
