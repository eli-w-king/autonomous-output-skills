# UX research platform credentials.
#
# SETUP (macOS, Linux):
#   cp ~/.copilot/skills/autonomous-research/research.env.template ~/.copilot/research.env
#   chmod 600 ~/.copilot/research.env
# SETUP (Windows PowerShell):
#   Copy-Item ~\.copilot\skills\autonomous-research\research.env.template ~\.copilot\research.env
#   icacls $HOME\.copilot\research.env /inheritance:r /grant:r "${env:USERNAME}:F"
#   ...then paste your real values into research.env (NOT this template).
#
# research.env is the only file that holds secrets. Never commit it, never
# paste its contents into chat. Tooling reads it from disk directly.

# --- Hey Marvin (OAuth2 client_credentials) -------------------------------
# Created in the Marvin web UI under Settings -> MCP.
# Client ID is public-ish and looks like  cid-mrv_...
# Secret is shown ONCE at creation and looks like  sk-mrv_...
# Keys expire 30-180 days after creation; you must rotate them by hand.
MARVIN_CLIENT_ID=
MARVIN_CLIENT_SECRET=
# Change only if your Marvin account is on EU data residency.
MARVIN_BASE_URL=https://app.heymarvin.com
MARVIN_MCP_URL=https://mcp.heymarvin.com

# --- Outset.ai ------------------------------------------------------------
# From the Outset app. Outset publishes no public API docs, so the probe
# script auto-discovers which auth style and paths your key actually works
# with. The sign-in (outset-auth.mjs) is per machine; it saves the MCP URL and
# a refresh token that rotates on every use.
OUTSET_API_KEY=
OUTSET_BASE_URL=https://api.outset.ai
OUTSET_MCP_URL=https://api.outset.ai/mcp

# Research loop only: a second Outset connection that CAN publish and launch.
# Written by `node outset-auth.mjs --launch`; used by scripts/research-loop/launch.mjs
# after its budget check and by nothing else. Leave it out unless the user has
# pre-approved launching for a research loop within caps.
# OUTSET_LAUNCH_CLIENT_ID=
# OUTSET_LAUNCH_REFRESH_TOKEN=

# --- User Interviews ------------------------------------------------------
# An account admin enables API access; the key is shown in Account -> API keys.
# The setup probe only lists recruits; it never creates or launches one.
USERINTERVIEWS_API_KEY=
# Browser tasks still need a signed-in account; the human enters passwords/2FA.
USERINTERVIEWS_ACCOUNT_EMAIL=
